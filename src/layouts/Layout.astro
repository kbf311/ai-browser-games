---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = 'ブラウザゲームコレクション' } = Astro.props;
---

<!doctype html>
<html lang="ja" class="min-h-full text-[18px]">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-[#0b0e14] text-base text-slate-100 antialiased">
		<slot />
	</body>
</html>
